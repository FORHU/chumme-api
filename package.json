{
  "name": "template-api-node",
  "version": "1.0.0",
  "main": "server.js",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --delay 2 --exec ts-node --files ./src/server.ts",
    "lint": "eslint src/**/*.ts --fix",
    "test": "NODE_ENV=development mocha --require ts-node/register 'test/**/*.spec.ts'",
    "build": "tsc",
    "start": "node ./dist/src/server.js",
    "start:worker": "node ./dist/src/worker.js",
    "dev:worker": "nodemon --watch src --ext ts --exec ts-node --files ./src/worker.ts",
    "db:setup": "npx prisma generate && npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "ingest:instagram": "ts-node scripts/instagram.script.ts",
    "scrape:instagram:comments": "ts-node scripts/scrapper/instagram-comments.ts",
    "test:audio": "mocha --require ts-node/register --timeout 60000 test/audio-utils.spec.ts",
    "test:integration": "mocha --require ts-node/register --timeout 60000 test/recording-flow.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.978.0",
    "@prisma/client": "^6.19.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/winston": "^2.4.4",
    "amqplib": "^0.10.9",
    "axios": "1.6.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "fast-xml-parser": "^5.7.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.6.1",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.2",
    "nodemailer": "^8.0.4",
    "openai": "^6.6.0",
    "prisma": "^6.12.0",
    "redis": "^4.7.1",
    "socket.io": "^4.7.2",
    "sockets": "^0.4.2",
    "winston": "^3.11.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^5.0.1",
    "@types/chai": "^4.3.8",
    "@types/express": "^4.17.18",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/mocha": "^10.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.8.3",
    "@types/node-cron": "^3.0.10",
    "@types/nodemailer": "^6.4.12",
    "@types/otp-generator": "^4.0.1",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^2.0.14",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "chai": "^4.3.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "mocha": "^11.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.3",
    "prism": "^1.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}

