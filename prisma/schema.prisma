generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String?
  name                   String?
  username               String                  @unique
  role                   Role                    @default(USER)
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  avatarId               String?
  isDeleted              Boolean                 @default(false)
  mobileNumber           String?
  otpCode                String?
  otpExpiry              DateTime?
  isEmailVerified        Boolean                 @default(false)
  onboardingCompleted    Boolean                 @default(false)
  nationality            String?
  chatSessionId          String?
  bookmarks              Bookmark[]
  chatMessages           ChatMessage[]
  comments               Comment[]
  conversations          Conversation[]
  emotionMemories        EmotionMemory[]
  following              Follow[]                @relation("UserFollows")
  followers              Follow[]                @relation("UserFollowers")
  likes                  Like[]
  messages               Message[]
  posts                  Post[]
  roomsOwned             Room[]                  @relation("RoomOwner")
  roomMembers            RoomMember[]
  sessions               Session[]
  avatar                 File?                   @relation(fields: [avatarId], references: [id])
  userArtists            UserArtist[]
  userChats              UserChat[]
  userEmotionPreferences UserEmotionPreference[]
  userInterests          UserInterest[]
  // ✅ FRIENDS
  // sentFriendRequests     UserFriend[]            @relation("FriendRequestSender")
  // receivedFriendRequests UserFriend[]            @relation("FriendRequestReceiver")

  // ✅ COLLABORATIONS
  // sentCollaborations     UserCollaboration[] @relation("CollabSender")
  // receivedCollaborations UserCollaboration[] @relation("CollabReceiver")
  musicRecords      MusicRecord[]  @relation("MusicRecordUsers")
  ownedStudios      MusicStudio[]  @relation("StudioOwner")
  studioMemberships StudioMember[] @relation("StudioMembership")
}

