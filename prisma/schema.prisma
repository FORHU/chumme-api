generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------
//  Start: Auth Section
// ----------------------------

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String?
  name                   String?
  username               String                  @unique
  role                   Role                    @default(USER)
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  avatarId               String?
  isDeleted              Boolean                 @default(false)
  mobileNumber           String?
  otpCode                String?
  otpExpiry              DateTime?
  isEmailVerified        Boolean                 @default(false)
  onboardingCompleted    Boolean                 @default(false)
  nationality            String?
  chatSessionId          String?
  bookmarks              Bookmark[]
  chatMessages           ChatMessage[]
  comments               Comment[]
  conversations          Conversation[]
  emotionMemories        EmotionMemory[]
  following              Follow[]                @relation("UserFollows")
  followers              Follow[]                @relation("UserFollowers")
  likes                  Like[]
  roomsOwned             RoomSubCategory[]       @relation("RoomSubCategoryOwner")
  messages               RoomMessage[]
  musicParts             MusicSingerPart[]
  ownedStudios           MusicStudio[]           @relation("StudioOwner")
  studioMemberships      MusicStudioMember[]     @relation("StudioMembership")
  playlists              Playlist[]
  posts                  Post[]
  sessions               Session[]
  avatar                 File?                   @relation(fields: [avatarId], references: [id])
  userArtists            UserArtist[]
  userChatRoom           RoomUserChat[]
  userEmotionPreferences UserEmotionPreference[]
  userInterests          UserInterest[]
  musicRecords           MusicRecord[]           @relation("MusicRecordSingers")
  messageReactions       RoomMessageReaction[]
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?
  providerUserId    String?
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider, providerUserId])
}

// ----------------------------
//  End: Auth Section
// ----------------------------

// ----------------------------
//  Start: Generic Section
// ----------------------------

model File {
  id            String         @id @default(uuid())
  filename      String?
  fileUrl       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  metaData      Json?
  artistPersona ArtistPersona? @relation("PersonaFile")
  mediaPosts    MediaPost[]
  voiceMessages RoomMessage[]  @relation("VoiceMessageFile")
  users         User[]
  videos        Video[]
}

// ----------------------------
//  End: Generic Section
// ----------------------------

// ----------------------------
//  Start: Room Chat Section
// ----------------------------

model RoomCategory {
  id      String  @id @default(uuid())
  name    String
  note    String?
  keyName String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  isAd      Boolean
  position  Json     @default("{}")
  colorSet  Json     @default("{}")
  sizeSet   Json     @default("{}")
  border    Json     @default("{}")
  shadow    Json     @default("{}")
  opacity   Float    @default(1)
  capacity  Int      @default(1)
  status    String   @default("active")
  metaData  Json     @default("{}")
  tags      String[] @default([])
  emojiIcon String   @default("")

  artists           Artist[]
  roomSubCategories RoomSubCategory[]
}

model RoomSubCategory {
  id      String  @id @default(uuid())
  name    String
  keyName String? @unique
  note    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  isAd      Boolean
  position  Json     @default("{}")
  colorSet  Json     @default("{}")
  sizeSet   Json     @default("{}")
  border    Json     @default("{}")
  shadow    Json     @default("{}")
  opacity   Float    @default(1)
  capacity  Int      @default(1)
  status    String   @default("active")
  metaData  Json     @default("{}")
  tags      String[] @default([])
  emojiIcon String   @default("")

  ownerId        String?
  roomCategoryId String
  owner          User?          @relation("RoomSubCategoryOwner", fields: [ownerId], references: [id])
  roomCategory   RoomCategory   @relation(fields: [roomCategoryId], references: [id])
  userChatRooms  RoomUserChat[]
  roomMessages   RoomMessage[]
}

model RoomUserChat {
  id                String       @id @default(uuid())
  userId            String
  roomSubCategoryId String
  userChatRole      UserChatRole @default(MEMBER)
  joinedAt          DateTime     @default(now())
  muted             Boolean      @default(false)
  lastSeenAt        DateTime?

  user            User            @relation(fields: [userId], references: [id])
  roomSubCategory RoomSubCategory @relation(fields: [roomSubCategoryId], references: [id])

  @@unique([userId, roomSubCategoryId])
  @@index([roomSubCategoryId])
}

model RoomMessage {
  id       String  @id @default(uuid())
  authorId String
  isSystem Boolean @default(false)

  content         Json?
  voiceMessageId  String?
  voiceMessage    File?                 @relation("VoiceMessageFile", fields: [voiceMessageId], references: [id])
  reactions       RoomMessageReaction[] @relation("MessageReactions")
  parentMessageId String?
  parentMessage   RoomMessage?          @relation("ThreadedMessages", fields: [parentMessageId], references: [id])
  replies         RoomMessage[]         @relation("ThreadedMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author            User            @relation(fields: [authorId], references: [id])
  roomSubCategory   RoomSubCategory @relation(fields: [roomSubCategoryId], references: [id])
  roomSubCategoryId String

  @@index([roomSubCategoryId, createdAt])
  @@index([authorId, createdAt])
}

model RoomMessageReaction {
  id        String @id @default(uuid())
  messageId String
  userId    String
  emoji     String

  createdAt DateTime @default(now())

  message RoomMessage @relation(fields: [messageId], references: [id], name: "MessageReactions")
  user    User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ----------------------------
//  End: Room Chat Section
// ----------------------------

// ----------------------------
//  Start: AI Chat Section
// ----------------------------
model Conversation {
  id            String        @id @default(uuid())
  userId        String
  title         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime?
  isDeleted     Boolean       @default(false)
  chatMessages  ChatMessage[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, isDeleted])
}

model ChatMessage {
  id             String         @id @default(uuid())
  userId         String
  role           ChatRole       @default(USER)
  createdAt      DateTime       @default(now())
  message        String
  mediaUrl       String?
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  User           User           @relation(fields: [userId], references: [id])
  embedding      Embedding?
  emotionMemory  EmotionMemory?

  @@index([conversationId, createdAt])
  @@index([userId, conversationId])
}

model Embedding {
  id            String      @id @default(uuid())
  model         String
  vector        Json?
  createdAt     DateTime    @default(now())
  chatMessageId String      @unique
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
}

model EmotionMemory {
  id            String      @id @default(uuid())
  chatMessageId String      @unique
  userId        String
  emotion       String
  confidence    Float
  createdAt     DateTime    @default(now())
  ChatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
  User          User        @relation(fields: [userId], references: [id])
}

// ----------------------------
//  Start: Social & Discovery Section
// ----------------------------

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  follower    User     @relation("UserFollows", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  icon          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(uuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())
  interest   Interest @relation(fields: [interestId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model Emotion {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  icon                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isDeleted              Boolean                 @default(false)
  mediaPostEmotions      MediaPostEmotion[]
  userEmotionPreferences UserEmotionPreference[]
  videoEmotions          VideoEmotion[]
}

model UserEmotionPreference {
  id        String   @id @default(uuid())
  userId    String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, emotionId])
  @@index([userId])
  @@index([emotionId])
}

// ----------------------------
//  End: Social & Discovery Section
// ----------------------------

// ----------------------------
//  Start: Artist Section
// ----------------------------

model Artist {
  id                String           @id @default(uuid())
  name              String           @unique
  bio               String?
  imageUrl          String?
  nationality       String?
  genre             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isDeleted         Boolean          @default(false)
  instagramUsername String?
  tiktokUsername    String?
  persona           ArtistPersona?
  featuredArtists   FeaturedArtist[]
  mediaPosts        MediaPost[]
  music             Music[]          @relation("MainArtist")
  musicAlbum        MusicAlbum[]     @relation("MainArtist")
  roomCategories    RoomCategory[]
  userArtists       UserArtist[]
  videos            Video[]
}

model ArtistPersona {
  id             String    @id @default(uuid())
  artistId       String?   @unique
  personaVoiceId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  personaFileId  String    @unique
  artist         Artist?   @relation(fields: [artistId], references: [id])
  personaFile    File      @relation("PersonaFile", fields: [personaFileId], references: [id])

  @@index([artistId])
}

model UserArtist {
  id        String   @id @default(uuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

// ----------------------------
//  End: Artist Section
// ----------------------------

// ----------------------------
//  Start: Feed Section
// ----------------------------

model Post {
  id        String     @id @default(uuid())
  userId    String
  content   String
  mediaUrls String[]   @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isDeleted Boolean    @default(false)
  comments  Comment[]
  feedItems FeedItem[]
  likes     Like[]
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
}

model FeedItem {
  id          String       @id @default(uuid())
  type        FeedItemType
  postId      String?
  videoId     String?
  createdAt   DateTime     @default(now())
  isDeleted   Boolean      @default(false)
  mediaPostId String?
  artistId    String?
  bookmarks   Bookmark[]
  MediaPost   MediaPost?   @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  video       Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([artistId])
  @@index([mediaPostId])
  @@index([postId])
  @@index([videoId])
}

model Bookmark {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  feedId    String
  feed      FeedItem  @relation(fields: [feedId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([feedId, userId], name: "userFeed")
}

// ----------------------------
//  End: Feed Section
// ----------------------------

// ----------------------------
//  Start: remove table
// ----------------------------

model Video {
  id            String         @id @default(uuid())
  title         String
  platform      VideoPlatform
  artistId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  fileId        String
  meta_data     Json?
  externalUrl   String?        @unique
  feedItems     FeedItem[]
  artist        Artist?        @relation(fields: [artistId], references: [id])
  file          File           @relation(fields: [fileId], references: [id])
  videoEmotions VideoEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model VideoEmotion {
  id        String   @id @default(uuid())
  videoId   String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([videoId, emotionId])
  @@index([videoId])
  @@index([emotionId])
}

model MediaPost {
  id                String             @id @default(uuid())
  title             String
  platform          VideoPlatform
  artistId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)
  fileId            String
  meta_data         Json?
  externalUrl       String?            @unique
  feedItems         FeedItem[]
  artist            Artist?            @relation(fields: [artistId], references: [id])
  file              File               @relation(fields: [fileId], references: [id])
  mediaPostEmotions MediaPostEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model MediaPostEmotion {
  id          String    @id @default(uuid())
  mediaPostId String
  emotionId   String
  createdAt   DateTime  @default(now())
  emotion     Emotion   @relation(fields: [emotionId], references: [id])
  mediaPost   MediaPost @relation(fields: [mediaPostId], references: [id])

  @@unique([mediaPostId, emotionId])
  @@index([mediaPostId])
  @@index([emotionId])
}

// ----------------------------
//  End: remove table
// ----------------------------

// ----------------------------
//  Music Section
// ----------------------------

model Playlist {
  id          String          @id @default(uuid())
  name        String
  description String
  imageUrl    String
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  tracks      MusicPlaylist[]
  user        User            @relation(fields: [userId], references: [id])
}

model MusicPlaylist {
  id         String    @id @default(uuid())
  musicId    String
  playlistId String
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt
  music      Music     @relation(fields: [musicId], references: [id])
  playlist   Playlist  @relation(fields: [playlistId], references: [id])

  @@unique([musicId, playlistId])
}

model MusicAlbum {
  id            String    @id @default(uuid())
  album         String
  genre         String
  language      String
  musicArtistId String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  music         Music[]
  musicArtist   Artist?   @relation("MainArtist", fields: [musicArtistId], references: [id])

  @@index([musicArtistId])
}

model FeaturedArtist {
  id        String   @id @default(uuid())
  artistId  String
  musicId   String
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id])
  music     Music    @relation(fields: [musicId], references: [id])

  @@unique([artistId, musicId])
}

model MusicLibrary {
  id               String            @id @default(uuid())
  filename         String?
  fileUrl          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  metaData         Json?
  fileType         MusicFileType     @default(MUSIC)
  musicFiles       Music[]           @relation("MusicLibraryFile")
  musicRecords     MusicRecord[]     @relation("MusicRecordLibraryFile")
  tempMusicRecords MusicTempRecord[] @relation("TempMusicLibraryFile")
}

model Music {
  id              String            @id @default(uuid())
  musicArtistId   String?
  title           String
  duration        Float?
  bpm             Int?
  hasWordTiming   Boolean           @default(false)
  release_date    DateTime
  musicAlbumId    String?
  createdAt       DateTime          @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime          @updatedAt
  isKaraoke       Boolean           @default(false)
  musicFileId     String
  featuredArtists FeaturedArtist[]
  musicAlbum      MusicAlbum?       @relation(fields: [musicAlbumId], references: [id])
  musicArtist     Artist?           @relation("MainArtist", fields: [musicArtistId], references: [id])
  musicFile       MusicLibrary      @relation("MusicLibraryFile", fields: [musicFileId], references: [id])
  parts           MusicSingerPart[]
  playlists       MusicPlaylist[]
  records         MusicRecord[]

  @@index([musicArtistId])
  @@index([musicAlbumId])
  @@index([musicFileId])
}

model MusicSingerPart {
  id             String       @id @default(uuid())
  musicId        String?
  recordId       String?
  name           String?
  startLine      Int
  endLine        Int
  vocalRoleIndex Int          @default(1)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  singerId       String?
  music          Music?       @relation(fields: [musicId], references: [id])
  record         MusicRecord? @relation(fields: [recordId], references: [id])
  singer         User?        @relation(fields: [singerId], references: [id])

  @@index([recordId])
  @@index([musicId])
}

model MusicStudioMember {
  id             String      @id @default(uuid())
  userId         String
  studioId       String
  role           StudioRole  @default(LISTENER)
  isActive       Boolean     @default(true)
  joinedAt       DateTime    @default(now())
  leftAt         DateTime?
  vocalRoleIndex Int?
  studio         MusicStudio @relation("StudioMembers", fields: [studioId], references: [id])
  user           User        @relation("StudioMembership", fields: [userId], references: [id])

  @@unique([userId, studioId])
  @@index([studioId])
  @@index([userId])
}

model MusicStudio {
  id            String              @id @default(uuid())
  name          String
  note          String?
  keyName       String?
  ownerId       String
  createdAt     DateTime            @default(now())
  deletedAt     DateTime?
  updatedAt     DateTime            @updatedAt
  relayInterval Int?
  relayMode     RelayMode           @default(AUTO)
  studioType    StudioType          @default(RELAYSINGING)
  records       MusicRecord[]       @relation("StudioRecords")
  owner         User                @relation("StudioOwner", fields: [ownerId], references: [id])
  members       MusicStudioMember[] @relation("StudioMembers")
  tempRecords   MusicTempRecord[]   @relation("StudioTempRecords")
}

model MusicRecord {
  id             String            @id @default(uuid())
  musicId        String
  fileId         String
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?
  studioId       String
  updatedAt      DateTime          @updatedAt
  metaData       Json?
  recordDuration Float?
  musicParts     MusicSingerPart[]
  file           MusicLibrary      @relation("MusicRecordLibraryFile", fields: [fileId], references: [id])
  music          Music             @relation(fields: [musicId], references: [id])
  studio         MusicStudio       @relation("StudioRecords", fields: [studioId], references: [id])
  singers        User[]            @relation("MusicRecordSingers")
}

model MusicTempRecord {
  id              String       @id @default(uuid())
  musicId         String
  fileId          String
  studioId        String
  order           Int?
  startTimeOffset Float?
  metaData        Json?
  recordDuration  Float?
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime     @updatedAt
  file            MusicLibrary @relation("TempMusicLibraryFile", fields: [fileId], references: [id])
  studio          MusicStudio  @relation("StudioTempRecords", fields: [studioId], references: [id])

  @@index([studioId])
}

// ----------------------------
//  Enums
// ----------------------------

enum Role {
  USER
  ADMIN
}

enum VideoPlatform {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum FeedItemType {
  POST
  VIDEO
  MEDIA_POST
}

enum ChatRole {
  USER
  AI
  ADMIN
}

enum StudioRole {
  LISTENER
  SINGER
  PRODUCER
}

enum StudioType {
  RELAYSINGING
  CROWDSINGING
  COMPETITION
}

enum RelayMode {
  AUTO
  MANUAL
  INTERVAL
  PHRASING
}

enum MusicFileType {
  MUSIC
  KARAOKE
  PREVIEW
  RECORDING
  VOCAL
  INSTRUMENTAL
  OTHER
}

enum UserChatRole {
  OWNER
  ADMIN
  MEMBER
}
