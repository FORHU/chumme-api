generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String
  name                   String?
  username               String                  @unique
  role                   Role                    @default(USER)
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  provider               String?
  avatarId               String?
  isDeleted              Boolean                 @default(false)
  mobileNumber           String?
  otpCode                String?
  otpExpiry              DateTime?
  isEmailVerified        Boolean                 @default(false)
  onboardingCompleted    Boolean                 @default(false)
  chatMessages           ChatMessage[]
  comments               Comment[]
  emotionMemories        EmotionMemory[]
  following              Follow[]                @relation("UserFollows")
  followers              Follow[]                @relation("UserFollowers")
  likes                  Like[]
  messages               Message[]
  posts                  Post[]
  roomsOwned             Room[]                  @relation("RoomOwner")
  roomMembers            RoomMember[]
  sessions               Session[]
  avatar                 File?                   @relation(fields: [avatarId], references: [id])
  userArtists            UserArtist[]
  userEmotionPreferences UserEmotionPreference[]
  userInterests          UserInterest[]
  bookmarks              Bookmark[]
  nationality            String?
  userChats              UserChat[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  refreshToken String   @unique
  user         User     @relation(fields: [userId], references: [id])
}

model File {
  id         String      @id @default(uuid())
  filename   String?
  fileUrl    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  metaData   Json?
  mediaPosts MediaPost[]
  users      User[]
  videos     Video[]
}

model UserChat {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  roomChat  Room      @relation(fields: [roomId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Room {
  id        String       @id @default(uuid())
  name      String?
  isPrivate Boolean      @default(false)
  ownerId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  isDeleted Boolean      @default(false)
  note      String?
  messages  Message[]
  owner     User         @relation("RoomOwner", fields: [ownerId], references: [id])
  userChats UserChat[]
  members   RoomMember[]
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  authorId  String
  content   String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
}

model ChatMessage {
  id            String         @id @default(uuid())
  userId        String
  role          ChatRole       @default(USER)
  createdAt     DateTime       @default(now())
  message       String
  User          User           @relation(fields: [userId], references: [id])
  embedding     Embedding?
  emotionMemory EmotionMemory?
}

model Embedding {
  id            String      @id @default(uuid())
  model         String
  vector        Json?
  createdAt     DateTime    @default(now())
  chatMessageId String      @unique
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
}

model EmotionMemory {
  id            String      @id @default(uuid())
  chatMessageId String      @unique
  userId        String
  emotion       String
  confidence    Float
  createdAt     DateTime    @default(now())
  ChatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
  User          User        @relation(fields: [userId], references: [id])
}

model Post {
  id        String     @id @default(uuid())
  userId    String
  content   String
  mediaUrls String[]   @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isDeleted Boolean    @default(false)
  comments  Comment[]
  feedItems FeedItem[]
  likes     Like[]
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  follower    User     @relation("UserFollows", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  icon          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(uuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())
  interest   Interest @relation(fields: [interestId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model Emotion {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  icon                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isDeleted              Boolean                 @default(false)
  mediaPostEmotions      MediaPostEmotion[]
  userEmotionPreferences UserEmotionPreference[]
  videoEmotions          VideoEmotion[]
}

model MediaPostEmotion {
  id          String    @id @default(uuid())
  mediaPostId String
  emotionId   String
  createdAt   DateTime  @default(now())
  emotion     Emotion   @relation(fields: [emotionId], references: [id])
  mediaPost   MediaPost @relation(fields: [mediaPostId], references: [id])

  @@unique([mediaPostId, emotionId])
  @@index([mediaPostId])
  @@index([emotionId])
}

model UserEmotionPreference {
  id        String   @id @default(uuid())
  userId    String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, emotionId])
  @@index([userId])
  @@index([emotionId])
}

model Artist {
  id                String       @id @default(uuid())
  name              String       @unique
  bio               String?
  imageUrl          String?
  nationality       String?
  instagramUsername String?
  tiktokUsername    String?
  genre             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isDeleted         Boolean      @default(false)
  mediaPosts        MediaPost[]
  userArtists       UserArtist[]
  videos            Video[]
}

model UserArtist {
  id        String   @id @default(uuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model Video {
  id            String         @id @default(uuid())
  title         String
  platform      VideoPlatform
  artistId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  fileId        String
  meta_data     Json?
  externalUrl   String?        @unique
  feedItems     FeedItem[]
  artist        Artist?        @relation(fields: [artistId], references: [id])
  file          File           @relation(fields: [fileId], references: [id])
  videoEmotions VideoEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model VideoEmotion {
  id        String   @id @default(uuid())
  videoId   String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([videoId, emotionId])
  @@index([videoId])
  @@index([emotionId])
}

model MediaPost {
  id                String             @id @default(uuid())
  title             String
  platform          VideoPlatform
  artistId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)
  fileId            String
  meta_data         Json?
  externalUrl       String?            @unique
  feedItems         FeedItem[]
  artist            Artist?            @relation(fields: [artistId], references: [id])
  file              File               @relation(fields: [fileId], references: [id])
  mediaPostEmotions MediaPostEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model FeedItem {
  id          String       @id @default(uuid())
  type        FeedItemType
  postId      String?
  artistId    String?
  videoId     String?
  createdAt   DateTime     @default(now())
  isDeleted   Boolean      @default(false)
  mediaPostId String?
  MediaPost   MediaPost?   @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  video       Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]

  @@index([createdAt])
  @@index([type])
}

model Bookmark {
  id        String    @id @default(uuid())
  feedId    String
  feed      FeedItem  @relation(fields: [feedId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([feedId, userId], name: "userFeed")
}

enum Role {
  USER
  ADMIN
}

enum VideoPlatform {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum FeedItemType {
  POST
  VIDEO
  MEDIA_POST
}

enum ChatRole {
  USER
  AI
  ADMIN
}
