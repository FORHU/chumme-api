generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String?
  name                   String?
  username               String                  @unique
  role                   Role                    @default(USER)
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  avatarId               String?
  isDeleted              Boolean                 @default(false)
  mobileNumber           String?
  otpCode                String?
  otpExpiry              DateTime?
  isEmailVerified        Boolean                 @default(false)
  onboardingCompleted    Boolean                 @default(false)
  nationality            String?
  chatSessionId          String?
  bookmarks              Bookmark[]
  chatMessages           ChatMessage[]
  comments               Comment[]
  conversations          Conversation[]
  emotionMemories        EmotionMemory[]
  following              Follow[]                @relation("UserFollows")
  followers              Follow[]                @relation("UserFollowers")
  likes                  Like[]
  messages               Message[]
  ownedStudios           MusicStudio[]           @relation("StudioOwner")
  playlists              Playlist[]
  posts                  Post[]
  roomsOwned             Room[]                  @relation("RoomOwner")
  roomMembers            RoomMember[]
  sessions               Session[]
  studioMemberships      StudioMember[]          @relation("StudioMembership")
  avatar                 File?                   @relation(fields: [avatarId], references: [id])
  userArtists            UserArtist[]
  userChats              UserChat[]
  userEmotionPreferences UserEmotionPreference[]
  userInterests          UserInterest[]
  musicParts             MusicPart[]
  musicRecords           MusicRecord[]           @relation("MusicRecordSingers")
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?
  providerUserId    String?
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider, providerUserId])
}

model File {
  id            String         @id @default(uuid())
  filename      String?
  fileUrl       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  metaData      Json?
  mediaPosts    MediaPost[]
  users         User[]
  videos        Video[]
  artistPersona ArtistPersona? @relation("PersonaFile")
}

model MusicLibrary {
  id               String            @id @default(uuid())
  filename         String?
  fileUrl          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  metaData         Json?
  fileType         MusicFileType     @default(MUSIC)
  musicFiles       Music[]           @relation("MusicLibraryFile")
  musicRecords     MusicRecord[]     @relation("MusicRecordLibraryFile")
  tempMusicRecords TempMusicRecord[] @relation("TempMusicLibraryFile")
}

model UserChat {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  roomChat  Room      @relation(fields: [roomId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId], name: "room_id_user_id")
}

model RoomCategory {
  id       String  @id @default(uuid())
  name     String
  key_name String  @unique
  note     String?

  color        String
  imageUrl     String?
  isAd         Boolean
  membersCount Int
  metaData     Json
  position     Json
  size         String

  roomSubCategories RoomSubCategory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model RoomSubCategory {
  id       String  @id @default(uuid())
  name     String
  note     String?
  key_name String  @unique
  ownerId  String

  color        String
  imageUrl     String?
  isAd         Boolean
  membersCount Int
  metaData     Json
  position     Json
  size         String

  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id])

  roomCategoryId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
}

model Room {
  id        String  @id @default(uuid())
  name      String?
  isPrivate Boolean @default(false)

  note              String?
  key_name          String?
  roomSubCategoryId String?
  metaData          Json
  position          Json
  messages          Message[]

  ownerId         String
  owner           User             @relation("RoomOwner", fields: [ownerId], references: [id])
  roomSubCategory RoomSubCategory? @relation(fields: [roomSubCategoryId], references: [id])
  members         RoomMember[]
  userChats       UserChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId], name: "room_id_user_id")
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  authorId  String
  content   String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
}

model Conversation {
  id            String        @id @default(uuid())
  userId        String
  title         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime?
  isDeleted     Boolean       @default(false)
  chatMessages  ChatMessage[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, isDeleted])
}

model ChatMessage {
  id             String         @id @default(uuid())
  userId         String
  role           ChatRole       @default(USER)
  createdAt      DateTime       @default(now())
  message        String
  mediaUrl       String?
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  User           User           @relation(fields: [userId], references: [id])
  embedding      Embedding?
  emotionMemory  EmotionMemory?

  @@index([conversationId, createdAt])
  @@index([userId, conversationId])
}

model Embedding {
  id            String      @id @default(uuid())
  model         String
  vector        Json?
  createdAt     DateTime    @default(now())
  chatMessageId String      @unique
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
}

model EmotionMemory {
  id            String      @id @default(uuid())
  chatMessageId String      @unique
  userId        String
  emotion       String
  confidence    Float
  createdAt     DateTime    @default(now())
  ChatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
  User          User        @relation(fields: [userId], references: [id])
}

model Post {
  id        String     @id @default(uuid())
  userId    String
  content   String
  mediaUrls String[]   @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isDeleted Boolean    @default(false)
  comments  Comment[]
  feedItems FeedItem[]
  likes     Like[]
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  follower    User     @relation("UserFollows", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  icon          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(uuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())
  interest   Interest @relation(fields: [interestId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model Emotion {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  icon                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isDeleted              Boolean                 @default(false)
  mediaPostEmotions      MediaPostEmotion[]
  userEmotionPreferences UserEmotionPreference[]
  videoEmotions          VideoEmotion[]
}

model MediaPostEmotion {
  id          String    @id @default(uuid())
  mediaPostId String
  emotionId   String
  createdAt   DateTime  @default(now())
  emotion     Emotion   @relation(fields: [emotionId], references: [id])
  mediaPost   MediaPost @relation(fields: [mediaPostId], references: [id])

  @@unique([mediaPostId, emotionId])
  @@index([mediaPostId])
  @@index([emotionId])
}

model UserEmotionPreference {
  id        String   @id @default(uuid())
  userId    String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, emotionId])
  @@index([userId])
  @@index([emotionId])
}

model Artist {
  id                String            @id @default(uuid())
  name              String            @unique
  bio               String?
  imageUrl          String?
  nationality       String?
  genre             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isDeleted         Boolean           @default(false)
  instagramUsername String?
  tiktokUsername    String?
  featuredArtists   FeaturedArtist[]
  mediaPosts        MediaPost[]
  music             Music[]           @relation("MainArtist")
  musicAlbum        MusicAlbum[]      @relation("MainArtist")
  userArtists       UserArtist[]
  videos            Video[]
  roomSubCategories RoomSubCategory[]
  persona           ArtistPersona?
}

model ArtistPersona {
  id             String  @id @default(uuid())
  artistId       String? @unique
  personaVoiceId String
  personaFileId  String  @unique

  artist      Artist?   @relation(fields: [artistId], references: [id])
  personaFile File      @relation("PersonaFile", fields: [personaFileId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([artistId])
}

model UserArtist {
  id        String   @id @default(uuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model Video {
  id            String         @id @default(uuid())
  title         String
  platform      VideoPlatform
  artistId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  fileId        String
  meta_data     Json?
  externalUrl   String?        @unique
  feedItems     FeedItem[]
  artist        Artist?        @relation(fields: [artistId], references: [id])
  file          File           @relation(fields: [fileId], references: [id])
  videoEmotions VideoEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model VideoEmotion {
  id        String   @id @default(uuid())
  videoId   String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([videoId, emotionId])
  @@index([videoId])
  @@index([emotionId])
}

model MediaPost {
  id                String             @id @default(uuid())
  title             String
  platform          VideoPlatform
  artistId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)
  fileId            String
  meta_data         Json?
  externalUrl       String?            @unique
  feedItems         FeedItem[]
  artist            Artist?            @relation(fields: [artistId], references: [id])
  file              File               @relation(fields: [fileId], references: [id])
  mediaPostEmotions MediaPostEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model FeedItem {
  id          String       @id @default(uuid())
  type        FeedItemType
  postId      String?
  videoId     String?
  createdAt   DateTime     @default(now())
  isDeleted   Boolean      @default(false)
  mediaPostId String?
  artistId    String?
  bookmarks   Bookmark[]
  MediaPost   MediaPost?   @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  video       Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([artistId])
  @@index([mediaPostId])
  @@index([postId])
  @@index([videoId])
}

model Bookmark {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  feedId    String
  feed      FeedItem  @relation(fields: [feedId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([feedId, userId], name: "userFeed")
}

model Playlist {
  id          String          @id @default(uuid())
  name        String
  description String
  imageUrl    String
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  tracks      MusicPlaylist[]
  user        User            @relation(fields: [userId], references: [id])
}

model MusicPlaylist {
  id         String    @id @default(uuid())
  musicId    String
  playlistId String
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt
  music      Music     @relation(fields: [musicId], references: [id])
  playlist   Playlist  @relation(fields: [playlistId], references: [id])

  @@unique([musicId, playlistId])
}

model MusicAlbum {
  id            String    @id @default(uuid())
  album         String
  genre         String
  language      String
  musicArtistId String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  music         Music[]
  musicArtist   Artist?   @relation("MainArtist", fields: [musicArtistId], references: [id])

  @@index([musicArtistId])
}

model FeaturedArtist {
  id        String   @id @default(uuid())
  artistId  String
  musicId   String
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id])
  music     Music    @relation(fields: [musicId], references: [id])

  @@unique([artistId, musicId])
}

model Music {
  id              String           @id @default(uuid())
  musicArtistId   String?
  title           String
  duration        Float?
  bpm             Int?
  hasWordTiming   Boolean          @default(false)
  release_date    DateTime
  musicAlbumId    String?
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime         @updatedAt
  isKaraoke       Boolean          @default(false)
  musicFileId     String
  featuredArtists FeaturedArtist[]
  musicAlbum      MusicAlbum?      @relation(fields: [musicAlbumId], references: [id])
  musicArtist     Artist?          @relation("MainArtist", fields: [musicArtistId], references: [id])
  musicFile       MusicLibrary     @relation("MusicLibraryFile", fields: [musicFileId], references: [id])
  parts           MusicPart[]
  playlists       MusicPlaylist[]
  records         MusicRecord[]

  @@index([musicArtistId])
  @@index([musicAlbumId])
  @@index([musicFileId])
}

model MusicPart {
  id             String       @id @default(uuid())
  musicId        String?
  recordId       String?
  name           String?
  startLine      Int
  endLine        Int
  vocalRoleIndex Int          @default(1)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  music          Music?       @relation(fields: [musicId], references: [id])
  record         MusicRecord? @relation(fields: [recordId], references: [id])
  singerId       String?
  singer         User?        @relation(fields: [singerId], references: [id])

  @@index([recordId])
  @@index([musicId])
}

model StudioMember {
  id             String      @id @default(uuid())
  userId         String
  studioId       String
  role           StudioRole  @default(LISTENER)
  isActive       Boolean     @default(true)
  joinedAt       DateTime    @default(now())
  leftAt         DateTime?
  vocalRoleIndex Int?
  studio         MusicStudio @relation("StudioMembers", fields: [studioId], references: [id])
  user           User        @relation("StudioMembership", fields: [userId], references: [id])

  @@unique([userId, studioId])
  @@index([studioId])
  @@index([userId])
}

model MusicStudio {
  id            String            @id @default(uuid())
  name          String
  note          String?
  keyName       String?
  ownerId       String
  createdAt     DateTime          @default(now())
  deletedAt     DateTime?
  updatedAt     DateTime          @updatedAt
  relayInterval Int?
  relayMode     RelayMode         @default(AUTO)
  studioType    StudioType        @default(RELAYSINGING)
  records       MusicRecord[]     @relation("StudioRecords")
  owner         User              @relation("StudioOwner", fields: [ownerId], references: [id])
  members       StudioMember[]    @relation("StudioMembers")
  tempRecords   TempMusicRecord[] @relation("StudioTempRecords")
}

model MusicRecord {
  id             String       @id @default(uuid())
  musicId        String
  fileId         String
  studioId       String
  metaData       Json?
  recordDuration Float?
  musicParts     MusicPart[]
  file           MusicLibrary @relation("MusicRecordLibraryFile", fields: [fileId], references: [id])
  music          Music        @relation(fields: [musicId], references: [id])
  studio         MusicStudio  @relation("StudioRecords", fields: [studioId], references: [id])
  singers        User[]       @relation("MusicRecordSingers")
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  updatedAt      DateTime     @updatedAt
}

model TempMusicRecord {
  id              String       @id @default(uuid())
  musicId         String
  fileId          String
  studioId        String
  order           Int?
  startTimeOffset Float?
  metaData        Json?
  recordDuration  Float?
  studio          MusicStudio  @relation("StudioTempRecords", fields: [studioId], references: [id])
  file            MusicLibrary @relation("TempMusicLibraryFile", fields: [fileId], references: [id])
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime     @updatedAt

  @@index([studioId])
}

enum Role {
  USER
  ADMIN
}

enum VideoPlatform {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum FeedItemType {
  POST
  VIDEO
  MEDIA_POST
}

enum ChatRole {
  USER
  AI
  ADMIN
}

enum StudioRole {
  LISTENER
  SINGER
  PRODUCER
}

enum StudioType {
  RELAYSINGING
  CROWDSINGING
  COMPETITION
}

enum RelayMode {
  AUTO
  MANUAL
  INTERVAL
  PHRASING
}

enum MusicFileType {
  MUSIC
  KARAOKE
  PREVIEW
  RECORDING
  VOCAL
  INSTRUMENTAL
  OTHER
}
