model Session {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?
  providerUserId    String?
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider, providerUserId])
}

model File {
  id           String        @id @default(uuid())
  filename     String?
  fileUrl      String?
  metaData     Json?
  mediaPosts   MediaPost[]
  users        User[]
  videos       Video[]
  musicFiles   Music[]       @relation("MusicFile")
  musicRecords MusicRecord[] @relation("MusicRecordFile")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model UserChat {
  id        String    @id @default(uuid())
  roomId    String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  roomChat  Room      @relation(fields: [roomId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId], name: "room_id_user_id")
}

model RoomCategory {
  id                String            @id @default(uuid())
  name              String
  key_name          String
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  roomSubCategories RoomSubCategory[]
}

model RoomSubCategory {
  id             String       @id @default(uuid())
  name           String
  key_name       String
  note           String?
  roomCategoryId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  rooms          Room[]
  roomCategory   RoomCategory @relation(fields: [roomCategoryId], references: [id])
}

model Room {
  id                String   @id @default(uuid())
  name              String?
  isPrivate         Boolean  @default(false)
  ownerId           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isDeleted         Boolean  @default(false)
  note              String?
  key_name          String?
  roomSubCategoryId String?

  messages        Message[]
  owner           User             @relation("RoomOwner", fields: [ownerId], references: [id])
  roomSubCategory RoomSubCategory? @relation(fields: [roomSubCategoryId], references: [id])
  members         RoomMember[]
  userChats       UserChat[]
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId], name: "room_id_user_id")
}

model Message {
  id       String  @id @default(uuid())
  roomId   String
  authorId String
  content  String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
}

model Conversation {
  id            String        @id @default(uuid())
  userId        String
  title         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime?
  isDeleted     Boolean       @default(false)
  chatMessages  ChatMessage[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, isDeleted])
}

model ChatMessage {
  id             String         @id @default(uuid())
  userId         String
  role           ChatRole       @default(USER)
  createdAt      DateTime       @default(now())
  message        String
  mediaUrl       String?
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  User           User           @relation(fields: [userId], references: [id])
  embedding      Embedding?
  emotionMemory  EmotionMemory?

  @@index([conversationId, createdAt])
  @@index([userId, conversationId])
}

model Embedding {
  id            String                 @id @default(uuid())
  model         String
  vector        Json?
  createdAt     DateTime               @default(now())
  chatMessageId String                 @unique
  chatMessage   ChatMessage            @relation(fields: [chatMessageId], references: [id])
  vector_search Unsupported("vector")?

  @@index([vector_search], map: "embedding_vector_search_idx")
}

model EmotionMemory {
  id            String      @id @default(uuid())
  chatMessageId String      @unique
  userId        String
  emotion       String
  confidence    Float
  createdAt     DateTime    @default(now())
  ChatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
  User          User        @relation(fields: [userId], references: [id])
}

model Post {
  id        String     @id @default(uuid())
  userId    String
  content   String
  mediaUrls String[]   @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isDeleted Boolean    @default(false)
  comments  Comment[]
  feedItems FeedItem[]
  likes     Like[]
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  follower    User     @relation("UserFollows", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  icon          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(uuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())
  interest   Interest @relation(fields: [interestId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model Emotion {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  icon                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isDeleted              Boolean                 @default(false)
  mediaPostEmotions      MediaPostEmotion[]
  userEmotionPreferences UserEmotionPreference[]
  videoEmotions          VideoEmotion[]
}

model MediaPostEmotion {
  id          String    @id @default(uuid())
  mediaPostId String
  emotionId   String
  createdAt   DateTime  @default(now())
  emotion     Emotion   @relation(fields: [emotionId], references: [id])
  mediaPost   MediaPost @relation(fields: [mediaPostId], references: [id])

  @@unique([mediaPostId, emotionId])
  @@index([mediaPostId])
  @@index([emotionId])
}

model UserEmotionPreference {
  id        String   @id @default(uuid())
  userId    String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, emotionId])
  @@index([userId])
  @@index([emotionId])
}

model Artist {
  id                String           @id @default(uuid())
  name              String           @unique
  bio               String?
  imageUrl          String?
  nationality       String?
  genre             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isDeleted         Boolean          @default(false)
  instagramUsername String?
  tiktokUsername    String?
  mediaPosts        MediaPost[]
  userArtists       UserArtist[]
  videos            Video[]
  musicAlbum        MusicAlbum[]     @relation("MainArtist")
  featuredArtists   FeaturedArtist[]
  music             Music[]          @relation("MainArtist")
}

model UserArtist {
  id        String   @id @default(uuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model Video {
  id            String         @id @default(uuid())
  title         String
  platform      VideoPlatform
  artistId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  fileId        String
  meta_data     Json?
  externalUrl   String?        @unique
  feedItems     FeedItem[]
  artist        Artist?        @relation(fields: [artistId], references: [id])
  file          File           @relation(fields: [fileId], references: [id])
  videoEmotions VideoEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model VideoEmotion {
  id        String   @id @default(uuid())
  videoId   String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([videoId, emotionId])
  @@index([videoId])
  @@index([emotionId])
}

model MediaPost {
  id                String             @id @default(uuid())
  title             String
  platform          VideoPlatform
  artistId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)
  fileId            String
  meta_data         Json?
  externalUrl       String?            @unique
  feedItems         FeedItem[]
  artist            Artist?            @relation(fields: [artistId], references: [id])
  file              File               @relation(fields: [fileId], references: [id])
  mediaPostEmotions MediaPostEmotion[]

  @@index([artistId])
  @@index([platform])
  @@index([fileId])
}

model FeedItem {
  id          String       @id @default(uuid())
  type        FeedItemType
  postId      String?
  videoId     String?
  createdAt   DateTime     @default(now())
  isDeleted   Boolean      @default(false)
  mediaPostId String?
  artistId    String?
  bookmarks   Bookmark[]
  MediaPost   MediaPost?   @relation(fields: [mediaPostId], references: [id], onDelete: Cascade)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  video       Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
}

model Bookmark {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  feedId    String
  feed      FeedItem  @relation(fields: [feedId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([feedId, userId], name: "userFeed")
}

model Playlist {
  id          String @id @default(uuid())
  name        String
  description String
  imageUrl    String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tracks MusicPlaylist[]
}

model MusicAlbum {
  id       String @id @default(uuid())
  album    String
  genre    String
  language String

  musicArtistId String?
  musicArtist   Artist? @relation("MainArtist", fields: [musicArtistId], references: [id])

  music Music[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FeaturedArtist {
  id       String @id @default(uuid())
  artistId String
  musicId  String

  artist Artist @relation(fields: [artistId], references: [id])
  music  Music  @relation(fields: [musicId], references: [id])

  createdAt DateTime @default(now())

  @@unique([artistId, musicId])
}

model Music {
  id String @id @default(uuid())

  musicArtistId String?
  musicArtist   Artist? @relation("MainArtist", fields: [musicArtistId], references: [id])

  featuredArtists FeaturedArtist[]

  title         String
  duration      Float?
  bpm           Int?
  hasWordTiming Boolean  @default(false)
  release_date  DateTime
  musicFileId   String
  musicFile     File     @relation("MusicFile", fields: [musicFileId], references: [id])
  isKaraoke     Boolean  @default(false)

  musicAlbum   MusicAlbum? @relation(fields: [musicAlbumId], references: [id])
  musicAlbumId String?

  playlists MusicPlaylist[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  records MusicRecord[]
}

model StudioMember {
  id String @id @default(uuid())

  userId String
  user   User   @relation("StudioMembership", fields: [userId], references: [id])

  studioId String
  studio   MusicStudio @relation("StudioMembers", fields: [studioId], references: [id])

  role     StudioRole @default(LISTENER)
  isActive Boolean    @default(true)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([userId, studioId])
  @@index([studioId])
  @@index([userId])
}

model MusicStudio {
  id   String  @id @default(uuid())
  name String
  note String?

  keyName String? // Optional - if null, studio is public

  // Owner relation - user who created the studio
  ownerId String
  owner   User   @relation("StudioOwner", fields: [ownerId], references: [id])

  // Members - users currently in the studio (via junction table)
  members StudioMember[] @relation("StudioMembers")

  // Recording output
  musicRecordId String?
  musicRecord   MusicRecord? @relation(fields: [musicRecordId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
}

model MusicRecord {
  id String @id @default(uuid())

  users User[] @relation("MusicRecordUsers")

  musicId String
  music   Music  @relation(fields: [musicId], references: [id])

  fileId String
  file   File   @relation("MusicRecordFile", fields: [fileId], references: [id])

  createdAt    DateTime      @default(now())
  deletedAt    DateTime?     @updatedAt
  musicStudios MusicStudio[]
}

model MusicPlaylist {
  id         String @id @default(uuid())
  musicId    String
  playlistId String
  order      Int    @default(0)

  music    Music    @relation(fields: [musicId], references: [id])
  playlist Playlist @relation(fields: [playlistId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([musicId, playlistId])
}

enum Role {
  USER
  ADMIN
}

enum VideoPlatform {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum FeedItemType {
  POST
  VIDEO
  MEDIA_POST
}

enum ChatRole {
  USER
  AI
  ADMIN
}

enum StudioRole {
  LISTENER
  SINGER
  PRODUCER
}

