generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String?
  name                   String?
  username               String                  @unique
  role                   Role                    @default(USER)
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  avatarId               String?
  isDeleted              Boolean                 @default(false)
  mobileNumber           String?
  otpCode                String?
  otpExpiry              DateTime?
  isEmailVerified        Boolean                 @default(false)
  onboardingCompleted    Boolean                 @default(false)
  nationality            String?
  chatSessionId          String?
  chatMessages           ChatMessage[]
  roomsOwned             ChummeSubCategory[]     @relation("ChummeSubCategoryOwner")
  conversations          Conversation[]
  emotionMemories        EmotionMemory[]
  following              Follow[]                @relation("UserFollows")
  followers              Follow[]                @relation("UserFollowers")
  musicPlaylists         MusicPlaylist[]
  musicSingerParts       MusicSingerPart[]
  musicStudios           MusicStudio[]           @relation("StudioOwner")
  musicStudioMemberships MusicStudioMember[]     @relation("StudioMembership")
  roomMessage            RoomMessage[]
  messageReactions       RoomMessageReaction[]
  userChatRoom           RoomUserChat[]
  sessions               Session[]
  sessionSocialAccounts  SessionSocialAccount[]
  socialUserBookmarks    SocialUserBookmark[]
  socialUserComments     SocialUserComment[]
  socialUserDiscoveries  SocialUserDiscovery?
  socialUserLikes        SocialUserLike[]
  socialUserPosts        SocialUserPost[]
  socialUserViews        SocialUserView[]
  avatar                 File?                   @relation("UserAvatar", fields: [avatarId], references: [id])
  userEmotionPreferences UserEmotionPreference[]
  userInterests          UserInterest[]
  musicRecords           MusicRecord[]           @relation("MusicRecordSingers")
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?
  providerUserId    String?
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider, providerUserId])
}

model SessionSocialAccount {
  id             String    @id @default(uuid())
  userId         String
  platform       String
  providerUserId String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
}

model File {
  id            String               @id @default(uuid())
  filename      String?
  fileUrl       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  metaData      Json?
  personaAudio  ChummeArtistPersona? @relation("PersonaAudioFile")
  personaImage  ChummeArtistPersona? @relation("PersonaImageFile")
  personaVideo  ChummeArtistPersona? @relation("PersonaVideoFile")
  voiceMessages RoomMessage[]        @relation("VoiceMessageFile")
  users         User[]               @relation("UserAvatar")
}

model ChummeCategory {
  id                    String                @id @default(uuid())
  name                  String
  note                  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  isAd                  Boolean               @default(false)
  chummeVisualDesignId  String?               @unique
  keyPassword           String?
  populationCount       Int                   @default(0)
  chummeTraits          ChummeTraits          @default(NONE)
  socialUserDiscoveryId String?
  chummeVisualDesign    ChummeCategoryDesign? @relation("CategoryDesign", fields: [chummeVisualDesignId], references: [id])
  socialUserDiscovery   SocialUserDiscovery?  @relation(fields: [socialUserDiscoveryId], references: [id])
  chummeSubCategories   ChummeSubCategory[]
  chummeArtists         ChummeArtist[]        @relation("ChummeArtistToChummeCategory")
}

model ChummeSubCategory {
  id                    String                @id @default(uuid())
  name                  String
  note                  String?
  chummeCategoryId      String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  ownerId               String?
  chummeVisualDesignId  String?               @unique
  isAd                  Boolean               @default(false)
  keyPassword           String?
  populationCount       Int                   @default(0)
  chummeTraits          ChummeTraits          @default(NONE)
  socialUserDiscoveryId String?
  chummeCategory        ChummeCategory        @relation(fields: [chummeCategoryId], references: [id])
  chummeVisualDesign    ChummeCategoryDesign? @relation("SubCategoryDesign", fields: [chummeVisualDesignId], references: [id])
  owner                 User?                 @relation("ChummeSubCategoryOwner", fields: [ownerId], references: [id])
  socialUserDiscoveries SocialUserDiscovery?  @relation(fields: [socialUserDiscoveryId], references: [id])
  chummeTopicCategories ChummeTopicCategory[]
  roomMessages          RoomMessage[]
  userChatRooms         RoomUserChat[]
}

model ChummeTopicCategory {
  id                    String                @id @default(uuid())
  name                  String
  note                  String?
  keyPassword           String?
  isAd                  Boolean               @default(false)
  chummeTraits          ChummeTraits          @default(NONE)
  populationCount       Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  chummeSubCategoryId   String
  chummeVisualDesignId  String?               @unique
  socialUserDiscoveryId String?
  chummeSubCategory     ChummeSubCategory     @relation(fields: [chummeSubCategoryId], references: [id])
  chummeVisualDesign    ChummeCategoryDesign? @relation("TopicCategoryDesign", fields: [chummeVisualDesignId], references: [id])
  socialUserDiscoveries SocialUserDiscovery?  @relation(fields: [socialUserDiscoveryId], references: [id])
}

model ChummeCategoryDesign {
  id                  String               @id @default(uuid())
  name                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  metaData            Json                 @default("{}")
  position            Json                 @default("{}")
  colorSet            Json                 @default("{}")
  sizeSet             Json                 @default("{}")
  border              Json                 @default("{}")
  shadow              Json                 @default("{}")
  opacity             Float                @default(1)
  capacity            Int                  @default(1)
  status              String               @default("active")
  tags                String[]             @default([])
  emojiIcon           String               @default("")
  chummeCategory      ChummeCategory?      @relation("CategoryDesign")
  chummeSubCategory   ChummeSubCategory?   @relation("SubCategoryDesign")
  chummeTopicCategory ChummeTopicCategory? @relation("TopicCategoryDesign")
}

model ChummeArtist {
  id                   String                @id @default(uuid())
  name                 String                @unique
  bio                  String?
  imageUrl             String?
  nationality          String?
  genre                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isDeleted            Boolean               @default(false)
  instagramUsername    String?
  tiktokUsername       String?
  chummeArtistPersona  ChummeArtistPersona?
  music                Music[]               @relation("MainArtist")
  musicAlbum           MusicAlbum[]          @relation("MainArtist")
  musicFeaturedArtists MusicFeaturedArtist[]
  socialFeedItems      SocialFeedItem[]
  chummeCategories     ChummeCategory[]      @relation("ChummeArtistToChummeCategory")
}

model ChummeArtistPersona {
  id             String        @id @default(uuid())
  chummeArtistId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  audioPathId    String?       @unique
  imagePathId    String?       @unique
  videoPathId    String?       @unique
  name           String
  persona        String
  voiceKey       String
  audioPath      File?         @relation("PersonaAudioFile", fields: [audioPathId], references: [id])
  chummeArtist   ChummeArtist? @relation(fields: [chummeArtistId], references: [id])
  imagePath      File?         @relation("PersonaImageFile", fields: [imagePathId], references: [id])
  videoPath      File?         @relation("PersonaVideoFile", fields: [videoPathId], references: [id])

  @@index([chummeArtistId])
}

model SocialUserDiscovery {
  id                    String                @id @default(uuid())
  userId                String                @unique
  createdAt             DateTime              @default(now())
  chummeCategories      ChummeCategory[]
  chummeSubCategories   ChummeSubCategory[]
  chummeTopicCategories ChummeTopicCategory[]
  user                  User                  @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SocialUserLike {
  id             String         @id @default(uuid())
  socialPostId   String
  userId         String
  createdAt      DateTime       @default(now())
  isDeleted      Boolean        @default(false)
  socialUserPost SocialUserPost @relation(fields: [socialPostId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@unique([socialPostId, userId])
  @@index([socialPostId])
  @@index([userId])
}

model SocialUserPost {
  id                 String              @id @default(uuid())
  userId             String
  content            String
  mediaUrls          String[]            @default([])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDeleted          Boolean             @default(false)
  socialFeedItem     SocialFeedItem?
  socialUserComments SocialUserComment[]
  socialUserLikes    SocialUserLike[]
  user               User                @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SocialUserComment {
  id                    String              @id @default(uuid())
  socialUserPostId      String
  userId                String
  parentSocialCommentId String?
  content               String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  isDeleted             Boolean             @default(false)
  parentSocialComment   SocialUserComment?  @relation("ThreadedComments", fields: [parentSocialCommentId], references: [id])
  replies               SocialUserComment[] @relation("ThreadedComments")
  socialUserPost        SocialUserPost      @relation(fields: [socialUserPostId], references: [id])
  user                  User                @relation(fields: [userId], references: [id])

  @@index([socialUserPostId])
  @@index([userId])
}

model SocialUserBookmark {
  id               String         @id @default(uuid())
  userId           String
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?
  updatedAt        DateTime       @updatedAt
  socialFeedItemId String
  socialFeedItem   SocialFeedItem @relation(fields: [socialFeedItemId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@unique([socialFeedItemId, userId], name: "userFeed")
}

model SocialUserView {
  id               String         @id @default(uuid())
  userId           String
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?
  updatedAt        DateTime       @updatedAt
  socialFeedItemId String
  socialFeedItem   SocialFeedItem @relation(fields: [socialFeedItemId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@unique([socialFeedItemId, userId], name: "userFeed")
}

model SocialFeedItem {
  id                 String               @id @default(uuid())
  postId             String?              @unique
  createdAt          DateTime             @default(now())
  isDeleted          Boolean              @default(false)
  externalUrl        String?              @unique
  metaData           Json?
  title              String?
  chummeArtistId     String?
  socialPlatform     SocialPlatform?
  chummeArtist       ChummeArtist?        @relation(fields: [chummeArtistId], references: [id])
  post               SocialUserPost?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  stats              SocialFeedStats?
  socialUserBookmark SocialUserBookmark[]
  socialUserViews    SocialUserView[]

  @@index([createdAt])
  @@index([chummeArtistId])
  @@index([postId])
}

model SocialFeedStats {
  socialFeedId   String         @id
  views          Int            @default(0)
  likes          Int            @default(0)
  comments       Int            @default(0)
  bookmarks      Int            @default(0)
  score          Float          @default(0)
  socialFeedItem SocialFeedItem @relation(fields: [socialFeedId], references: [id], onDelete: Cascade)
}

model RoomUserChat {
  id                  String            @id @default(uuid())
  userId              String
  chummeSubCategoryId String
  userChatRole        UserChatRole      @default(MEMBER)
  joinedAt            DateTime          @default(now())
  muted               Boolean           @default(false)
  lastSeenAt          DateTime?
  chummeSubCategory   ChummeSubCategory @relation(fields: [chummeSubCategoryId], references: [id])
  user                User              @relation(fields: [userId], references: [id])

  @@unique([userId, chummeSubCategoryId])
  @@index([chummeSubCategoryId])
}

model RoomMessage {
  id                  String                @id @default(uuid())
  authorId            String
  isSystem            Boolean               @default(false)
  content             Json?
  voiceMessageId      String?
  parentMessageId     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  chummeSubCategoryId String
  author              User                  @relation(fields: [authorId], references: [id])
  chummeSubCategory   ChummeSubCategory     @relation(fields: [chummeSubCategoryId], references: [id])
  parentMessage       RoomMessage?          @relation("ThreadedMessages", fields: [parentMessageId], references: [id])
  replies             RoomMessage[]         @relation("ThreadedMessages")
  voiceMessage        File?                 @relation("VoiceMessageFile", fields: [voiceMessageId], references: [id])
  reactions           RoomMessageReaction[] @relation("MessageReactions")

  @@index([chummeSubCategoryId, createdAt])
  @@index([authorId, createdAt])
}

model RoomMessageReaction {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   RoomMessage @relation("MessageReactions", fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Conversation {
  id            String        @id @default(uuid())
  userId        String
  title         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime?
  isDeleted     Boolean       @default(false)
  chatMessages  ChatMessage[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, isDeleted])
}

model ChatMessage {
  id             String          @id @default(uuid())
  userId         String
  createdAt      DateTime        @default(now())
  message        String
  mediaUrl       String?
  conversationId String?
  role           ChatMessageRole @default(USER)
  conversation   Conversation?   @relation(fields: [conversationId], references: [id])
  User           User            @relation(fields: [userId], references: [id])
  embedding      Embedding?
  emotionMemory  EmotionMemory?

  @@index([conversationId, createdAt])
  @@index([userId, conversationId])
}

model Embedding {
  id            String      @id @default(uuid())
  model         String
  vector        Json?
  createdAt     DateTime    @default(now())
  chatMessageId String      @unique
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
}

model EmotionMemory {
  id            String      @id @default(uuid())
  chatMessageId String      @unique
  userId        String
  emotion       String
  confidence    Float
  createdAt     DateTime    @default(now())
  ChatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id])
  User          User        @relation(fields: [userId], references: [id])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  follower    User     @relation("UserFollows", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  icon          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(uuid())
  userId     String
  interestId String
  createdAt  DateTime @default(now())
  interest   Interest @relation(fields: [interestId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model Emotion {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  icon                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isDeleted              Boolean                 @default(false)
  mediaPostEmotions      MediaPostEmotion[]
  userEmotionPreferences UserEmotionPreference[]
}

model UserEmotionPreference {
  id        String   @id @default(uuid())
  userId    String
  emotionId String
  createdAt DateTime @default(now())
  emotion   Emotion  @relation(fields: [emotionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, emotionId])
  @@index([userId])
  @@index([emotionId])
}

model MediaPost {
  id                String             @id @default(uuid())
  title             String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)
  fileId            String
  meta_data         Json?
  externalUrl       String?            @unique
  chummeArtistId    String?
  platform          SocialPlatform
  mediaPostEmotions MediaPostEmotion[]

  @@index([chummeArtistId])
  @@index([platform])
  @@index([fileId])
}

model MediaPostEmotion {
  id          String    @id @default(uuid())
  mediaPostId String
  emotionId   String
  createdAt   DateTime  @default(now())
  emotion     Emotion   @relation(fields: [emotionId], references: [id])
  mediaPost   MediaPost @relation(fields: [mediaPostId], references: [id])

  @@unique([mediaPostId, emotionId])
  @@index([mediaPostId])
  @@index([emotionId])
}

model MusicFeaturedArtist {
  id             String       @id @default(uuid())
  chummeArtistId String
  musicId        String
  createdAt      DateTime     @default(now())
  chummeArtist   ChummeArtist @relation(fields: [chummeArtistId], references: [id])
  music          Music        @relation(fields: [musicId], references: [id])

  @@unique([chummeArtistId, musicId])
}

model MusicPlaylist {
  id          String             @id @default(uuid())
  musicId     String?
  createdAt   DateTime           @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime           @updatedAt
  description String
  imageUrl    String
  name        String
  userId      String
  music       Music?             @relation(fields: [musicId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  tracks      MusicSubPlaylist[]
}

model MusicSubPlaylist {
  id         String        @id @default(uuid())
  musicId    String
  playlistId String
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime      @updatedAt
  music      Music         @relation(fields: [musicId], references: [id])
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id])

  @@unique([musicId, playlistId])
}

model MusicAlbum {
  id            String        @id @default(uuid())
  album         String
  genre         String
  language      String
  musicArtistId String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  music         Music[]
  musicArtist   ChummeArtist? @relation("MainArtist", fields: [musicArtistId], references: [id])

  @@index([musicArtistId])
}

model MusicLibrary {
  id               String            @id @default(uuid())
  filename         String?
  fileUrl          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  metaData         Json?
  fileType         MusicFileType     @default(MUSIC)
  musicFiles       Music[]           @relation("MusicLibraryFile")
  musicRecords     MusicRecord[]     @relation("MusicRecordLibraryFile")
  tempMusicRecords MusicTempRecord[] @relation("TempMusicLibraryFile")
}

model Music {
  id                   String                @id @default(uuid())
  musicArtistId        String?
  title                String
  duration             Float?
  bpm                  Int?
  hasWordTiming        Boolean               @default(false)
  release_date         DateTime
  musicAlbumId         String?
  createdAt            DateTime              @default(now())
  deletedAt            DateTime?
  updatedAt            DateTime              @updatedAt
  isKaraoke            Boolean               @default(false)
  musicFileId          String
  musicAlbum           MusicAlbum?           @relation(fields: [musicAlbumId], references: [id])
  musicArtist          ChummeArtist?         @relation("MainArtist", fields: [musicArtistId], references: [id])
  musicFile            MusicLibrary          @relation("MusicLibraryFile", fields: [musicFileId], references: [id])
  musicFeaturedArtists MusicFeaturedArtist[]
  playlists            MusicPlaylist[]
  records              MusicRecord[]
  parts                MusicSingerPart[]
  musicSubPlaylists    MusicSubPlaylist[]

  @@index([musicArtistId])
  @@index([musicAlbumId])
  @@index([musicFileId])
}

model MusicSingerPart {
  id             String       @id @default(uuid())
  musicId        String?
  recordId       String?
  name           String?
  startLine      Int
  endLine        Int
  vocalRoleIndex Int          @default(1)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  singerId       String?
  music          Music?       @relation(fields: [musicId], references: [id])
  record         MusicRecord? @relation(fields: [recordId], references: [id])
  singer         User?        @relation(fields: [singerId], references: [id])

  @@index([recordId])
  @@index([musicId])
}

model MusicStudioMember {
  id             String          @id @default(uuid())
  userId         String
  studioId       String
  isActive       Boolean         @default(true)
  joinedAt       DateTime        @default(now())
  leftAt         DateTime?
  vocalRoleIndex Int?
  role           MusicStudioRole @default(LISTENER)
  studio         MusicStudio     @relation("StudioMembers", fields: [studioId], references: [id])
  user           User            @relation("StudioMembership", fields: [userId], references: [id])

  @@unique([userId, studioId])
  @@index([studioId])
  @@index([userId])
}

model MusicStudio {
  id            String              @id @default(uuid())
  name          String
  note          String?
  ownerId       String
  createdAt     DateTime            @default(now())
  deletedAt     DateTime?
  updatedAt     DateTime            @updatedAt
  relayInterval Int?
  relayMode     MusicRelayMode      @default(AUTO)
  studioType    MusicStudioType     @default(RELAYSINGING)
  /// @description Null/Empty = public, otherwise private
  keyPassword   String?
  records       MusicRecord[]       @relation("StudioRecords")
  owner         User                @relation("StudioOwner", fields: [ownerId], references: [id])
  members       MusicStudioMember[] @relation("StudioMembers")
  tempRecords   MusicTempRecord[]   @relation("StudioTempRecords")
}

model MusicRecord {
  id             String            @id @default(uuid())
  musicId        String
  fileId         String
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?
  studioId       String
  updatedAt      DateTime          @updatedAt
  metaData       Json?
  recordDuration Float?
  file           MusicLibrary      @relation("MusicRecordLibraryFile", fields: [fileId], references: [id])
  music          Music             @relation(fields: [musicId], references: [id])
  studio         MusicStudio       @relation("StudioRecords", fields: [studioId], references: [id])
  musicParts     MusicSingerPart[]
  singers        User[]            @relation("MusicRecordSingers")
}

model MusicTempRecord {
  id              String       @id @default(uuid())
  musicId         String
  fileId          String
  studioId        String
  order           Int?
  startTimeOffset Float?
  metaData        Json?
  recordDuration  Float?
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime     @updatedAt
  file            MusicLibrary @relation("TempMusicLibraryFile", fields: [fileId], references: [id])
  studio          MusicStudio  @relation("StudioTempRecords", fields: [studioId], references: [id])

  @@index([studioId])
}

enum Role {
  USER
  ADMIN
}

enum SocialPlatform {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum ChatMessageRole {
  USER
  AI
  ADMIN
}

enum MusicStudioRole {
  LISTENER
  SINGER
  PRODUCER
}

enum MusicStudioType {
  RELAYSINGING
  CROWDSINGING
  COMPETITION
}

enum MusicRelayMode {
  AUTO
  MANUAL
  INTERVAL
  PHRASING
}

enum MusicFileType {
  MUSIC
  KARAOKE
  PREVIEW
  RECORDING
  VOCAL
  INSTRUMENTAL
  OTHER
}

enum UserChatRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChummeTraits {
  NONE
  COMMUNITIES
  ENTERTAINMENT
}
