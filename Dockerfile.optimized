# Multi-stage Dockerfile for better optimization and error handling
FROM node:22-alpine AS base

# Install required packages for native dependencies
RUN apk add --no-cache python3 make g++ git

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --include=dev

# Build stage
FROM base AS build

# Copy source code
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Build the application
RUN npm run build

# Production stage - start fresh for smaller image
FROM node:22-alpine AS production

# Install only runtime dependencies
RUN apk add --no-cache dumb-init

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Copy package files
COPY package*.json ./

# Install only production dependencies (without build tools)
RUN npm ci --only=production && npm cache clean --force

# Copy built application and generated Prisma client from build stage
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma

# The schema and migration history must ship with the image: without them the
# entrypoint cannot apply migrations or diff the live schema, and this stage
# would start an API against a database nobody verified. The `prisma` CLI is a
# regular dependency (not a devDependency), so `npm ci --only=production` above
# already installed it.
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/scripts ./scripts

# Change ownership
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 3000

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
# Previously `npm start`, which skipped migrations entirely. An image built from
# this file would boot against whatever schema the database happened to have --
# a second, silent path to the 2026-08-03 auth outage.
CMD ["sh", "./scripts/start.sh"]