# Template for the app.env that docker-compose.prod.yaml reads on the EC2 box.
#
# DO NOT create this file by hand on the instance. .github/workflows/deploy.yml
# writes ~/chumme-api/app.env on every deploy from GitHub Secrets, so the box
# never holds a value that isn't in the repo settings. This file exists only to
# document what the workflow must supply — keep the two in sync.
#
# Anything marked (secret) goes in GitHub -> Settings -> Secrets and variables ->
# Actions -> Secrets. Anything marked (var) can be a plain Variable instead.

# --- Runtime ---------------------------------------------------------------
# NOTE: src/config.ts derives isDev from NODE_ENV, NOT from a variable literally
# named `isDev`. The local .env's `isDev=production` line is read by nothing.
# Setting NODE_ENV here is what actually flips production behaviour — including
# INGESTION_QUEUE_NAME, which silently defaults to "ingestion_jobs_local" when
# NODE_ENV is unset.
NODE_ENV=production
PORT=3002
# Set to "false" to skip the in-process FFmpeg audio-merge and ingestion workers.
# Worth considering on a shared box — they compete with BOOSTK for CPU.
START_WORKERS=true

# --- Database (secret) -----------------------------------------------------
# The shared staging RDS instance, database `chumme-main`. NOT a container.
DATABASE_URL=postgresql://<user>:<password>@<rds-host>:5432/chumme-main?schema=public&sslmode=require

# --- Auth (secret) ---------------------------------------------------------
# Generate FRESH values with: openssl rand -hex 32
# Do NOT copy these from the local .env — docs/SECRET-ROTATION.md lists both as
# exposed in git history, and the values still in .env are byte-identical to the
# leaked ones, i.e. never rotated. Anyone with repo history can currently mint
# valid access tokens.
ACCESS_TOKEN_SECRET=<64-hex-chars>
REFRESH_TOKEN_SECRET=<64-hex-chars>
ACCESS_TOKEN_EXPIRY=1d

# --- Redis -----------------------------------------------------------------
# `redis` is the compose service name, resolved on the internal Docker network.
# Never "localhost" here — that would resolve to the app container itself.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# --- RabbitMQ --------------------------------------------------------------
# The first three configure the rabbitmq CONTAINER; RABBITMQ_URL is what the app
# dials. Host is `rabbitmq` (service name) and the vhost must match.
RABBITMQ_DEFAULT_USER=<user>
RABBITMQ_DEFAULT_PASS=<password>          # (secret)
RABBITMQ_DEFAULT_VHOST=my_vhost
RABBITMQ_URL=amqp://<user>:<password>@rabbitmq:5672/my_vhost
RABBITMQ_EXCHANGE=chumme_exchange
RABBITMQ_QUEUE_PREFIX=chumme
INGESTION_QUEUE_NAME=ingestion_jobs

# --- Mailer (secret) -------------------------------------------------------
# Registration is gated on an OTP email (src/services/auth.service.ts). If these
# are wrong, signup succeeds but no account can ever be verified.
MAILER_TRANSPORT_HOST=smtp.gmail.com
MAILER_TRANSPORT_PORT=587
MAILER_TRANSPORT_SECURE=false
MAILER_EMAIL=<address>
MAILER_PASSWORD=<gmail-app-password>

# --- AWS S3 ----------------------------------------------------------------
# NO CREDENTIALS HERE, deliberately. In production S3 runs on the EC2 instance
# role `production-chumme-instance` (inline policy `chumme-app-runtime-s3`,
# scoped to the dev-chumme bucket). `utils/s3-client.ts` only passes explicit
# credentials when both are present, so leaving them unset lets the SDK's
# default provider chain reach instance metadata.
#
# Setting AWS_ACCESS_KEY_ID here would SILENTLY TAKE PRECEDENCE over the role.
# That is how the previous outage looked from the outside: a deleted key kept
# winning over perfectly good instance credentials.
#
# Locally, either export a key pair in your own .env or use an AWS profile —
# the same chain picks up ~/.aws/credentials with no code change.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=<bucket>
S3_CDN_URL=https://<distribution>.cloudfront.net

# --- Third-party APIs (secret) ---------------------------------------------
# OPENAI_API_KEY is also on the rotation list — revoke the old one at
# platform.openai.com rather than merely replacing it.
OPENAI_API_KEY=<sk-proj-...>
YOUTUBE_API_KEY=<key>
CHAT_WONDER_API_URL=<url>

# --- OAuth (var, not secret) -----------------------------------------------
# Client IDs are public by design — they ship in the mobile bundle.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=<id>.apps.googleusercontent.com

# --- Sports rooms (var, not secret) ----------------------------------------
# The User row that authors auto-posted match messages ("Kick off", "GOAL —
# 1-0"). RoomMessage.authorId is a required FK, so system messages still need a
# real account; create a dedicated one rather than reusing a person's.
#
# Unset means auto-posting is skipped entirely — fixtures and scores still
# ingest, the rooms just stay quiet. That is the safe default, not a failure.
SPORT_BOT_USER_ID=<uuid of the bot user>

# ---------------------------------------------------------------------------
# NOT LISTED, deliberately: SECRET_KEY, SERVICE_ACCOUNT, GOOGLE_CLIENT_SECRET,
# FACEBOOK_APP_ID, FACEBOOK_APP_SECRET, WEBSUB_CALLBACK_URL.
#
# Each is exported from src/config.ts or present in .env, but grep finds zero
# readers for any of them across the whole repo. They are leftovers. Do not
# create GitHub Secrets for them — that is six live credentials guarding
# nothing. Re-add here and in deploy.yml together if a feature starts using one.
# ---------------------------------------------------------------------------
