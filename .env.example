# Connect as the app's own role, never the server's master user. `sslmode=require` is not
# optional on a remote host — without it the driver silently accepts an unencrypted
# connection. Do NOT append connection_limit; src/utils/prisma.ts adds it at runtime.
# See docs/DATABASE-SETUP.md.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require"
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRY=""
OPENAI_API_KEY="your_openai_api_key_here"

MAILER_TRANSPORT_HOST=""
MAILER_TRANSPORT_PORT=""
MAILER_TRANSPORT_SECURE=""
MAILER_EMAIL=""
MAILER_PASSWORD=""

# Redis Configuration
REDIS_HOST=""
REDIS_PORT=""
REDIS_PASSWORD=""
REDIS_TTL_SECONDS=""

RABBITMQ_URL=amqp://admin:admin123@localhost:5672/my_vhost
YOUTUBE_API_KEY=""

# Chat-message translation: "google" (default) or "forhu". Google with an empty
# key falls back to FORHU (TRANSLATION_API_URL, default chat-dev.forhu.ai).
TRANSLATION_PROVIDER=""
GOOGLE_TRANSLATE_API_KEY=""
TRANSLATION_API_URL=""

# Logging (src/utils/logger.ts). All optional.
# LOG_DIR: where error/combined/chat-send logs go; relative paths resolve
#   against the working directory at startup. Default: ./logs
# LOG_LEVEL: error | warn | info | debug. Default: debug locally, info in production.
# LOG_MAX_SIZE / LOG_MAX_FILES: rotate at this size; keep this many days (or files).
LOG_DIR=""
LOG_LEVEL=""
LOG_MAX_SIZE=""
LOG_MAX_FILES=""
