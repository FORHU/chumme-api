# RabbitMQ Configuration
# Default connection URL for local development
RABBITMQ_URL=amqp://localhost:5672

# For RabbitMQ with authentication
# RABBITMQ_URL=amqp://username:password@localhost:5672

# For cloud RabbitMQ (CloudAMQP, AWS, etc.)
# RABBITMQ_URL=amqps://username:password@host:port/vhost

# Exchange name for your application
RABBITMQ_EXCHANGE=chumme_exchange

# Queue prefix for your application
RABBITMQ_QUEUE_PREFIX=chumme

# Example of other environment variables you might need
# NODE_ENV=development
# PORT=3001
# DATABASE_URL=your_database_url
# SECRET_KEY=your_secret_key