# Connect as the app's own role, never the server's master user. `sslmode=require` is not
# optional on a remote host — without it the driver silently accepts an unencrypted
# connection. Do NOT append connection_limit; src/utils/prisma.ts adds it at runtime.
# See docs/DATABASE-SETUP.md.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require"
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRY=""

MAILER_TRANSPORT_HOST=""
MAILER_TRANSPORT_PORT=""
MAILER_TRANSPORT_SECURE=""
MAILER_EMAIL=""
MAILER_PASSWORD=""

# Redis Configuration
REDIS_HOST=""
REDIS_PORT=""
REDIS_PASSWORD=""
REDIS_TTL_SECONDS=""

# SQS — local only. Points the SQS client at LocalStack (docker compose up -d
# localstack). Leave AWS_SQS_ENDPOINT unset on any deployed environment so the
# SDK uses real SQS. Queues are created by docker/localstack/init-queues.sh;
# 000000000000 is LocalStack's fixed account id.
AWS_SQS_ENDPOINT=http://localhost:4566
MEDIA_PROCESSING_QUEUE_URL=http://localhost:4566/000000000000/media_processing_queue
AUDIO_MERGE_QUEUE_URL=http://localhost:4566/000000000000/audio-merge-queue
INGESTION_JOBS_QUEUE_URL=http://localhost:4566/000000000000/ingestion_jobs
INGESTION_JOBS_HIGH_QUEUE_URL=http://localhost:4566/000000000000/ingestion_jobs_high

# SNS — local only, same rule as AWS_SQS_ENDPOINT. Not used by the app (jobs go
# straight to the queues above); kept for scripts/sns_smoke.ts and future fan-out.
AWS_SNS_ENDPOINT=http://localhost:4566
CHUMME_EVENTS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:chumme-events

YOUTUBE_API_KEY=""

# Chat-message translation: "google" (default) or "forhu". Google with an empty
# key falls back to FORHU (TRANSLATION_API_URL, default chat-dev.forhu.ai).
TRANSLATION_PROVIDER=""
GOOGLE_TRANSLATE_API_KEY=""
TRANSLATION_API_URL=""